    p.set_defaults(fn=cmd_export)
    p = sp.add_parser("status")
    p.set_defaults(fn=cmd_status)
    args, program_argv = sys.argv[1:], None
    if args and args[0] in ("t", "verify", "sweep", "batch"):
        if "--" not in args:
            fail("put the program's arguments after a lone --, e.g. ./pk t root --file a.txt -- -n a.txt "
                 "(./pk t root -- for a bare invocation)")
        k = args.index("--")
        args, program_argv = args[:k], args[k + 1:]
    # option names start with '-': glue them to their flag so argparse does not take them for options
    fixed = []
    for k, x in enumerate(args):
        if k and args[k - 1] in ("--option",) and x.startswith("-"):
            fixed[-1] = "--option=" + x
        else:
            fixed.append(x)
    a = ap.parse_args(fixed)
    if program_argv is not None:
        a.argv = program_argv
    if a.cmd == "spec":
        a.unit = a.unit or a.unit_opt
        if a.action == "amend" and (not a.unit or not a.cite):
            fail("spec amend needs UNIT and --cite TEST")
    a.fn(a)


