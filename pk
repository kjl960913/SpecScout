#!/usr/bin/env python3
"""pk -- probe_spec_code6_mini command line. Run from the framework directory; state lives in ./work.

Step 1   ./pk discover [BINARY]          help tree, help bytes, docs copy
         ./pk node add WORD... | node remove SLUG
         ./pk check 1
Step 2   ./pk iface draft SUB | iface check SUB
         ./pk t SUB [conditions] [--covers ID] -- ARGV...   run the gold (twice for nondeterminism), record it
         ./pk sweep SUB --list NAME | --list-file F --covers ID [conditions] -- ARGV with {W}
         ./pk batch SUB --cands F | --cand TEXT --covers ID [--split] [conditions] -- ARGV with {C}
                                              guess spellings: run many candidate forms at once
         ./pk features SUB                    checklist status (features.json + automatic items)
         ./pk tests SUB                       one line per recorded test
         ./pk coverage SUB                    controls, witnesses, gaps, checklist (first call runs the rule tests)
         ./pk ready SUB                       explorer: validate everything, hand over to the review agent
         ./pk finish SUB                      reviewer: validate again and freeze the clusters
Step 3   ./pk spec prepare SUB | spec check SUB [--unit U] | spec build SUB
         ./pk verify SUB --option NAME --assert ID --why TEXT [conditions] -- ARGV...
Step 4   ./pk diff [--entry ENTRY | --test ID]
         ./pk spec amend SUB UNIT --cite TEST --reason TEXT
         ./pk export DEST
Any      ./pk status
"""
